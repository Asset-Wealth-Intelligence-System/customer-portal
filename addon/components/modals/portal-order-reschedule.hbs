<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @name={{t "literal.customer-portal.new-delivery-time"}} @helpText={{t "literal.customer-portal.choose-the-preferred-delivery-date-and-time-for-1e8a5"}}>
            <DateTimeInput @value={{@options.reschedule.scheduled_at}} @onChange={{fn (mut @options.reschedule.scheduled_at)}} placeholder={{t "literal.customer-portal.select-date-and-time"}} class="w-full form-input" />
        </InputGroup>
    </div>
</Modal::Default>
